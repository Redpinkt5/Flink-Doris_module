{
  "memory": {
    "autoSyncIndex": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "name": "sync-memory-index",
        "script": "node -e \"const fs=require('fs');const p='MEMORY.md';const s=fs.statSync(p);fs.utimesSync(p,s.atime,new Date());console.log('index synced');\""
      }
    ]
  }
}
