{
  "memory": {
    "autoSyncIndex": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs');const p='MEMORY.md';if(fs.existsSync(p)){const s=fs.statSync(p);fs.utimesSync(p,s.atime,new Date());}\""
          }
        ]
      }
    ]
  }
}
